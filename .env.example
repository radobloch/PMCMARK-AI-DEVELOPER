# ==============================================================================
# PMCMARK AI Developer - Configuration & Environment Variables Template
# ==============================================================================
# Kopiuj ten plik do `.env` w katalogu głównym projektu przed uruchomieniem:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google AI Studio / Gemini API Configuration
# ------------------------------------------------------------------------------
# Wymagany klucz API do interakcji z modelami Gemini 3.6 Flash i generowania kodu.
# Uzyskaj darmowy klucz na: https://aistudio.google.com/
GOOGLE_AI_STUDIO_API_KEY="your-google-ai-studio-api-key-here"

# Opcjonalny zamiennik nazwy klucza dla kompatybilności z Gemini SDK
GEMINI_API_KEY="your-gemini-api-key-here"


# ------------------------------------------------------------------------------
# 2. GitHub REST API & Access Token
# ------------------------------------------------------------------------------
# Personal Access Token (PAT) dla wywołań GitHub API (Octokit).
# Wymagane uprawnienia: repo, read:user, user:email, write:discussion
# Wygeneruj na: https://github.com/settings/tokens
GITHUB_TOKEN="ghp_your_personal_access_token_here"


# ------------------------------------------------------------------------------
# 3. GitHub OAuth Application Credentials
# ------------------------------------------------------------------------------
# Client ID zarejestrowanej aplikacji GitHub OAuth do logowania użytkowników.
# Skonfiguruj w: GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_ID="your-github-oauth-client-id"

# Client Secret zarejestrowanej aplikacji GitHub OAuth.
GITHUB_SECRET="your-github-oauth-client-secret"


# ------------------------------------------------------------------------------
# 4. NextAuth.js Authentication Configuration
# ------------------------------------------------------------------------------
# Losowa, bezpieczna klucz do szyfrowania sesji i tokenów JWT w NextAuth.js.
# Możesz wygenerować komendą: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"

# Kanoniczny adres URL aplikacji używany przez NextAuth do przekierowań OAuth.
# Dla środowiska lokalnego: http://localhost:3000
# Dla środowiska produkcyjnego: https://twostrona.vercel.app
NEXTAUTH_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 5. Supabase Database & Auth Service Credentials
# ------------------------------------------------------------------------------
# Adres URL Twojego projektu w Supabase (np. https://xyzcompany.supabase.co).
# Znajdziesz w: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"

# Publiczny anonimowy klucz API Supabase (anon key) do bezpiecznych zapytań z klienta.
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-supabase-anon-key-here"


# ------------------------------------------------------------------------------
# 6. General Application & Development Environment Settings
# ------------------------------------------------------------------------------
# Port, na którym działa serwer deweloperski
PORT=3000

# Tryb środowiska uruchomieniowego: 'development' | 'production' | 'test'
NODE_ENV="development"
